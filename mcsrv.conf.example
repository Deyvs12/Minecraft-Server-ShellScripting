# =============================================================================
# configuración de mcsrv
#
# deploy crea en /etc/mcsrv/mcsrv.conf la primera vez.
# =============================================================================


# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------

SERVER_JAR=/opt/minecraft/server.jar
SERVER_PORT=25565

# SHA-1 oficial del jar, publicada por Mojang en su manifiesto de
# versiones. Obligatoria: deploy aborta si el jar no coincide.
EXPECTED_SHA1="823e2250d24b3ddac457a60c92a6a941943fcd6a"


# -----------------------------------------------------------------------------
# Java
# -----------------------------------------------------------------------------

# Mejor una ruta absoluta: el java del PATH puede no ser el que use systemd.
JAVA_BIN=java

# Versión major mínima exigida.
JAVA_MIN_VERSION=25


# -----------------------------------------------------------------------------
# Memoria
# -----------------------------------------------------------------------------

# Memoria libre mínima en MB para que deploy continúe.
MIN_RAM_MB=2048

# Heap de la JVM. Formato: número con K, M o G opcional.
JVM_XMX=2G
JVM_XMS=1G


# -----------------------------------------------------------------------------
# Reporte HTML
# -----------------------------------------------------------------------------

# Puerto en el que nginx publica el reporte. Distinto de SERVER_PORT.
REPORT_PORT=8080

# Restringe el reporte a este origen. Vacío = accesible desde cualquier IP.
# Admite una IP o una red: "192.168.1.50" o "192.168.1.0/24".
ADMIN_IP=""


# -----------------------------------------------------------------------------
# Monitoreo
# -----------------------------------------------------------------------------

# Segundos entre ciclos de métricas y regeneración del reporte.
MONITOR_INTERVAL=5

# Umbrales de alerta en porcentaje (1-100).
CPU_ALERT=80
MEM_ALERT=85


# -----------------------------------------------------------------------------
# Bloqueo automático de IPs
# -----------------------------------------------------------------------------

# Eventos de una misma IP dentro de la ventana que disparan el bloqueo.
IP_BLOCK_THRESHOLD=20
IP_BLOCK_WINDOW=60


# -----------------------------------------------------------------------------
# Rutas (opcionales, con valores por defecto en lib/common.sh)
# -----------------------------------------------------------------------------

#SERVER_DIR=/opt/minecraft
#SERVER_USER=mcserver
#STATE_DIR=/var/lib/mcsrv
#REPORT_DIR=/var/lib/mcsrv/report
#MCSRV_LOG_FILE=/var/log/mcsrv.log
